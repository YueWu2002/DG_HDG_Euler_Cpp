	cd /oscar/home/ywu355/DG_HDG_Euler_Cpp/speed_test/running/2d_n512_restart30_20261020T184417_j3nqwnjw/job_7681630/build-debug && $(CMAKE_COMMAND) -P /oscar/home/ywu355/DG_HDG_Euler_Cpp/speed_test/running/2d_n512_restart30_20261020T184417_j3nqwnjw/job_7681630/build-debug/CMakeFiles/VerifyGlobs.cmake
	cd /oscar/home/ywu355/DG_HDG_Euler_Cpp/speed_test/running/2d_n512_restart30_20261020T184417_j3nqwnjw/job_7681630/build-debug && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

