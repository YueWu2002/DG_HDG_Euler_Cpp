# BLAS selection and Eigen integration. Included once by DghBuild.cmake.
# Prefer optional MKL::MKL, then OpenBLAS, then any LP64 BLAS.
# Sequential MKL uses no project-level OpenMP/MPI dependency or parallel loop.
set(DGH_RESOLVED_BACKEND "NONE")
set(BLA_SIZEOF_INTEGER 4)
if(DGH_BLAS_BACKEND STREQUAL "AUTO" OR DGH_BLAS_BACKEND STREQUAL "MKL")
    set(MKL_LINK dynamic)
    set(MKL_INTERFACE lp64)
    set(MKL_THREADING sequential)
    find_package(MKL CONFIG QUIET)
    if(MKL_FOUND AND TARGET MKL::MKL)
        set(DGH_RESOLVED_BACKEND "MKL")
        set(DGH_BLAS_TARGET MKL::MKL)
        message(STATUS "MKL found: linking MKL::MKL (LP64, sequential)")
    elseif(DGH_BLAS_BACKEND STREQUAL "MKL")
        message(FATAL_ERROR "MKL requested but MKL::MKL was not found; set MKL_DIR/CMAKE_PREFIX_PATH")
    else()
        message(STATUS "MKL not found. Looking for OpenBLAS/BLAS instead.")
    endif()
endif()
if(DGH_BLAS_BACKEND STREQUAL "AUTO" AND DGH_RESOLVED_BACKEND STREQUAL "NONE")
    set(_dgh_saved_vendor "${BLA_VENDOR}")
    set(BLA_VENDOR OpenBLAS)
    find_package(BLAS QUIET)
    if(BLAS_FOUND)
        set(DGH_RESOLVED_BACKEND "OPENBLAS")
    else()
        if(_dgh_saved_vendor)
            set(BLA_VENDOR "${_dgh_saved_vendor}")
        else()
            unset(BLA_VENDOR)
        endif()
        find_package(BLAS QUIET)
        if(BLAS_FOUND)
            set(DGH_RESOLVED_BACKEND "BLAS")
        endif()
    endif()
elseif(DGH_BLAS_BACKEND STREQUAL "BLAS" OR DGH_BLAS_BACKEND STREQUAL "OPENBLAS")
    if(DGH_BLAS_BACKEND STREQUAL "OPENBLAS")
        set(BLA_VENDOR OpenBLAS)
    endif()
    find_package(BLAS REQUIRED)
    set(DGH_RESOLVED_BACKEND "${DGH_BLAS_BACKEND}")
endif()
if(DGH_RESOLVED_BACKEND STREQUAL "BLAS" OR DGH_RESOLVED_BACKEND STREQUAL "OPENBLAS")
    set(DGH_BLAS_TARGET BLAS::BLAS)
endif()
if(NOT DGH_RESOLVED_BACKEND STREQUAL "NONE")
    target_compile_definitions(dgh_build_options INTERFACE EIGEN_USE_BLAS)
    target_link_libraries(dgh_build_options INTERFACE ${DGH_BLAS_TARGET})
    message(STATUS "BLAS linked: YES (${DGH_RESOLVED_BACKEND}; target ${DGH_BLAS_TARGET})")
    if(BLAS_LIBRARIES AND NOT DGH_RESOLVED_BACKEND STREQUAL "MKL")
        message(STATUS "BLAS libraries: ${BLAS_LIBRARIES}")
    endif()
else()
    message(STATUS "BLAS linked: NO (using Eigen native kernels)")
endif()
target_compile_definitions(dgh_build_options INTERFACE DGH_EIGEN_BACKEND="${DGH_RESOLVED_BACKEND}")
message(STATUS "C++ compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION} (${CMAKE_CXX_COMPILER})")
message(STATUS "Eigen backend: ${DGH_RESOLVED_BACKEND} (requested ${DGH_BLAS_BACKEND})")
