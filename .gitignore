# Ignore generated binaries only; retain build configuration, logs and manifests.
/.deps/
__pycache__/
*.pyc
*.o
*.obj
*.a
*.so
*.so.*
*.exe
# CMake compiler identification/probe executables are internal build products.
**/CMakeFiles/**/a.out
**/CMakeFiles/**/*.bin
# Temporary immutable sources: remove on disk only after scheduler/dependency checks.
/accuracy_test/running/**/source/
/speed_test/running/**/source/
/code_test/running/**/source/
/accuracy_test/results/**/source/
/speed_test/results/**/source/
/code_test/results/**/source/
# CSV, out/err, environment/command logs, patches, CMake caches, build logs,
# resource statistics and provenance remain eligible for Git in every run tree.

# Frozen submission-control script copies are snapshots too; retain driver.sha256.
/accuracy_test/running/**/control/
/speed_test/running/**/control/
/code_test/running/**/control/
/accuracy_test/results/**/control/
/speed_test/results/**/control/
/code_test/results/**/control/

# CMake regeneration products are not experiment evidence. Keep diagnostics and
# compiler identity, even when CMake stores them inside CMakeFiles/.
**/CMakeFiles/**
!**/CMakeFiles/**/
!**/CMakeFiles/**/CMakeConfigureLog.yaml
!**/CMakeFiles/**/CMakeConfigureLog.yml
!**/CMakeFiles/**/*.log
!**/CMakeFiles/**/CMakeCXXCompiler.cmake
!**/CMakeFiles/**/CMakeSystem.cmake
!**/CMakeFiles/**/CMakeCache.txt
!**/CMakeFiles/**/compile_commands.json
**/build*/**/Makefile
**/build*/**/cmake_install.cmake
**/build*/**/CTestTestfile.cmake
**/build*/**/DartConfiguration.tcl
**/build*/**/build.ninja
**/build*/**/rules.ninja
**/build*/**/.ninja_deps
**/build*/**/.ninja_log
# Legacy compiler products predate the .exe convention. Preserve disk files.
**/build*/**/dg_hdg
**/build*/**/dg_hdg_2d
**/build*/**/check_1d
**/build*/**/check_2d
**/build*/**/benchmark_dg
**/bin/solver
